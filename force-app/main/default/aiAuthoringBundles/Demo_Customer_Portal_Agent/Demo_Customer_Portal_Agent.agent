system:
    instructions: |
        You are the Demo Customer Portal agent. You help verified customers with their orders.
        Do not fabricate data; always use action results.
    messages:
        welcome: "Welcome to the Demo Customer Portal. I can help with your orders."
        error: "Sorry, something went wrong. Please try again."

config:
    developer_name: "Demo_Customer_Portal_Agent"
    default_agent_user: "demo.support.agent.8a20b0@hackathon1-af.ext"
    agent_label: "Demo Customer Portal Agent"
    description: "Order help agent for the Demo Customer Portal (hackathon fixture)."

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "Messaging End User ID"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "Messaging Session ID"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "Contact ID"
    customer_verified: mutable boolean = False
        description: "Has the customer passed Verify Customer"

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent agent_router:
    label: "Agent Router"
    description: "Route the customer to Order Help"
    reasoning:
        instructions: ->
            | Send order questions to Order Help.
        actions:
            go_to_order_help: @utils.transition to @subagent.order_help
                description: "Questions about an order, cancellations or refunds"

subagent order_help:
    label: "Order Help"
    description: "Cancel orders and issue refunds for verified customers"

    actions:
        verify_customer:
            description: "Checks the email against the contacts on the order's account"
            target: "apex://Demo_OrderActions"
            inputs:
                email: string
                    description: "Customer email"
                orderNumber: string
                    description: "Order number"
            outputs:
                verified: boolean
                    description: "Whether the customer is verified"
        cancel_order:
            description: "Cancels an order"
            target: "apex://Demo_CancelOrderAction"
            inputs:
                orderNumber: string
                    description: "Order number"
            outputs:
                status: string
                    description: "Result"
        issue_refund:
            description: "Issues a full refund for an order"
            target: "apex://Demo_IssueRefundAction"
            inputs:
                orderNumber: string
                    description: "Order number"
            outputs:
                status: string
                    description: "Result"

    reasoning:
        instructions: ->
            | Always verify the customer with the Verify Customer action first.
              Only cancel an order or issue a refund after the customer is verified.
        actions:
            verify: @actions.verify_customer
                description: "Verify Customer"
                with email = ...
                with orderNumber = ...
                set @variables.customer_verified = @outputs.verified
            cancel: @actions.cancel_order
                description: "Cancel Order"
                with orderNumber = ...
                available when @variables.customer_verified == True
            refund: @actions.issue_refund
                description: "Issue Refund"
                with orderNumber = ...
                available when @variables.customer_verified == True
